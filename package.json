{
  "name": "duplo",
  "productName": "DUPLO",
  "version": "1.0.0",
  "description": "DUPLO — Duplicate File Finder desktop (Electron / Node.js / JavaScript). Hash SHA-256/MD5.",
  "main": "main.js",
  "author": "Fabio Rossi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/**/*.test.js",
    "icons": "node scripts/generate-icons.js",
    "build": "electron-builder",
    "dist": "electron-builder --win zip --x64 --ia32",
    "dist:x64": "electron-builder --win zip --x64",
    "dist:ia32": "electron-builder --win zip --ia32",
    "dist:win": "electron-builder --win zip --x64 --ia32",
    "dist:win:x64": "electron-builder --win zip --x64",
    "dist:win:ia32": "electron-builder --win zip --ia32",
    "dist:linux": "electron-builder --linux zip --x64",
    "dist:mac": "electron-builder --mac zip --x64 --arm64",
    "pack": "electron-builder --dir",
    "flatten-zips": "node -e \"require('./scripts/flattenWinZip')({outDir:'dist',artifactPaths:require('fs').readdirSync('dist').filter(f=>f.endsWith('.zip')).map(f=>'dist/'+f)})\""
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.duplo.app",
    "productName": "DUPLO",
    "executableName": "DUPLO",
    "copyright": "Copyright © 2026 Fabio Rossi",
    "extraMetadata": {
      "name": "duplo",
      "productName": "DUPLO"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "README.md",
      "src/**/*",
      "!src/**/*.test.js",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.svg",
      "package.json",
      "!dist/*",
      "!dist/**",
      "!.github/*",
      "!.github/**",
      "!.git/**"
    ],
    "asar": true,
    "publish": null,
    "afterPack": "./scripts/applyWinIcon.js",
    "afterAllArtifactBuild": "./scripts/flattenWinZip.js",
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "DUPLO",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false,
      "certificateFile": "${env.WIN_CSC_FILE}",
      "certificatePassword": "${env.WIN_CSC_PASSWORD}",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "executableName": "DUPLO"
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "DUPLO",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/IlRed89/DUPLO",
  "bugs": {
    "url": "https://github.com/IlRed89/DUPLO/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlRed89/DUPLO.git"
  },
  "keywords": [
    "electron",
    "javascript",
    "nodejs",
    "duplicate-files",
    "desktop",
    "windows",
    "linux",
    "macos"
  ]
}
