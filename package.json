{
  "name": "dupfinder",
  "version": "1.0.0",
  "description": "Cross-platform fast, portable duplicate file finder GUI built with Electron and Node.js",
  "main": "main.js",
  "author": "Fabio Rossi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/**/*.test.js",
    "icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable --linux AppImage",
    "dist:win": "electron-builder --win portable",
    "dist:win-portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.fabiorossi.dupfinder",
    "productName": "DupFinder",
    "copyright": "Copyright © 2026 Fabio Rossi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "README.md",
      "src/**/*",
      "!src/**/*.test.js",
      "build/icon.png",
      "build/icon.svg",
      "package.json"
    ],
    "asar": true,
    "publish": null,
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-windows-portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "${productName}-mac-${arch}.dmg"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "${productName}-linux-${arch}.AppImage"
    },
    "portable": {
      "artifactName": "${productName}-windows-portable.exe"
    }
  }
}
