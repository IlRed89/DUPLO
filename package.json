{
  "name": "dupfinder",
  "version": "1.0.0",
  "description": "Cross-platform fast, portable duplicate file finder GUI built with Electron and Node.js",
  "main": "main.js",
  "author": "Fabio Rossi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/**/*.test.js",
    "icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win dir --linux dir",
    "dist:win": "electron-builder --win dir",
    "dist:win-dir": "electron-builder --win dir",
    "dist:mac": "electron-builder --mac dir",
    "dist:linux": "electron-builder --linux dir"
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.fabiorossi.dupfinder",
    "productName": "DupFinder",
    "copyright": "Copyright © 2026 Fabio Rossi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "README.md",
      "src/**/*",
      "!src/**/*.test.js",
      "build/icon.png",
      "build/icon.svg",
      "package.json"
    ],
    "asar": true,
    "publish": null,
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
