{
  "name": "dupfinder",
  "version": "1.0.0",
  "description": "Cross-platform fast, portable duplicate file finder GUI built with Electron and Node.js",
  "main": "main.js",
  "author": "Fabio Rossi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/**/*.test.js",
    "icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --linux",
    "dist:win": "electron-builder --win",
    "flatten-zips": "node -e \"require('./scripts/flattenWinZip')({outDir:'dist',artifactPaths:require('fs').readdirSync('dist').filter(f=>f.endsWith('.zip')).map(f=>'dist/'+f)})\"",
    "dist:win-dir": "electron-builder --win dir",
    "dist:mac": "electron-builder --mac dir",
    "dist:linux": "electron-builder --linux dir"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.fabiorossi.dupfinder",
    "productName": "DupFinder",
    "copyright": "Copyright © 2026 Fabio Rossi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "README.md",
      "src/**/*",
      "!src/**/*.test.js",
      "build/icon.png",
      "build/icon.svg",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "publish": null,
    "beforePack": "./scripts/stageFfmpegResources.js",
    "afterAllArtifactBuild": "./scripts/flattenWinZip.js",
    "extraResources": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "build/ffmpeg-staged",
        "to": "ffmpeg"
      },
      {
        "from": "node_modules/ffprobe-static/bin",
        "to": "ffprobe-bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "certificateFile": "${env.WIN_CSC_FILE}",
      "certificatePassword": "${env.WIN_CSC_PASSWORD}",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "DupFinder"
    }
  }
}
